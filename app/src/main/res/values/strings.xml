    <!-- Onboarding -->
    <string name="onb_1_title">Make a vow</string>
    <string name="onb_1_text">Give something up or take something on: no sugar, a cold shower, mornings without a phone. Choose how long and when it begins. Then seal it with wax.</string>
    <string name="onb_2_title">The seal can be broken, but not easily</string>
    <string name="onb_2_text">Every vow has its own ladder of release: a candle of waiting, your own voice, a letter, three questions, a witness. At any step you may still hold on.</string>
    <string name="onb_3_title">When temptation comes</string>
    <string name="onb_3_text">Light the candle and breathe with the flame. A craving rarely outlasts it. Every temptation held is a gold bead on your rope.</string>
    <string name="onb_4_title">And who are you?</string>
    <string name="onb_4_text">A name for the vows page. Everything stays on this phone.</string>
    <string name="onb_name_hint">Your name (optional)</string>
    <string name="onb_start">Begin</string>

